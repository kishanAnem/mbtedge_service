{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbtedge-service",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-31",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mbtedge-service-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
